# Gojo Trip Planner Environment Configuration
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=Gojo Trip Planner
ENVIRONMENT=development  # development, production

# Security
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./gojo.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_ECHO=False

# Cloud Storage (Cloudinary - free tier recommended for Render deployment)
# Get from https://cloudinary.com/console
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry Error Monitoring (Optional)
# SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
UPLOAD_DIR=uploads

# Frontend URL
SITE_URL=http://127.0.0.1:8000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Gemini AI (Optional - for itinerary & destination recommendations)
# Get free key from https://aistudio.google.com
GEMINI_API_KEY=

# Google Maps API (Optional - Leaflet.js works without it)
GOOGLE_MAPS_API_KEY=

# Web Push Notifications (Optional)
# Generate keys: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_key); print('PUBLIC:', v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
